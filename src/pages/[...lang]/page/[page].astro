---
import type { HomePage } from '@/utils/home'
import HomeListing from '@/components/HomeListing.astro'
import { allLocales } from '@/config'
import { getLangRouteParam } from '@/i18n/lang'
import { getHomePages } from '@/utils/home'

export async function getStaticPaths() {
  const paths = await Promise.all(allLocales.map(async (lang) => {
    const pages = await getHomePages(lang)
    return pages.slice(1).map(props => ({
      params: { lang: getLangRouteParam(lang), page: String(props.page) },
      props,
    }))
  }))
  return paths.flat()
}

type Props = HomePage
---

<HomeListing {...Astro.props} />
